# ==========================================
# Development Environment (staging publico)
# ==========================================
#
# Ambiente DEVELOPMENT publico na web.
# Nao e producao: nao usar dados reais.
#
# Copy this file to .env.dev and fill in the real values.
#
# Usage:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d
#
# NEVER commit .env.dev to Git.
# ==========================================


# ==========================================
# Frontend (unico servico exposto)
# ==========================================

DEV_HTTP_PORT=80


# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=saas_erp_dev
POSTGRES_USER=erp_dev
POSTGRES_PASSWORD=


# ==========================================
# JWT
# ==========================================

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================
# CORS
# ==========================================

CORS_ALLOWED_ORIGINS=http://localhost


# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO
LOG_JSON=true


# ==========================================
# Bootstrap (primeira subida do banco)
# ==========================================

BOOTSTRAP_DEV_EMPRESA_SLUG=dev
BOOTSTRAP_DEV_EMPRESA_NAME=Development
BOOTSTRAP_DEV_ADMIN_EMAIL=
BOOTSTRAP_DEV_ADMIN_PASSWORD=
BOOTSTRAP_DEV_ADMIN_NAME=
